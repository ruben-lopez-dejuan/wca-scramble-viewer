{
  "manifest_version": 3,
  "name": "WCA Scramble Viewer",
  "version": "1.0.0",
  "description": "Muestra la imagen de cada mezcla (como en TNoodle) junto a las mezclas de las competiciones de la WCA, con colores configurables.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "WCA Scramble Viewer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.worldcubeassociation.org/competitions/*"],
      "js": ["puzzles.js", "settings.js", "picker.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
